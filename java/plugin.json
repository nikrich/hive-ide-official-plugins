{
  "id": "hive-ide-official-plugins/java",
  "name": "Java",
  "version": "0.1.2",
  "description": "Java language support via Eclipse JDT Language Server (jdtls). Requires Java 21+ on PATH.",
  "publisher": "hive-ide-official-plugins",
  "engines": {
    "hive": ">=0.1.0 <1.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "java",
        "extensions": [
          ".java"
        ],
        "aliases": [
          "Java"
        ],
        "configuration": "./language-configuration.json",
        "grammar": "./grammar.json"
      }
    ],
    "languageServers": [
      {
        "language": "java",
        "command": "${pluginDir}/launch.sh",
        "args": [],
        "transport": "stdio",
        "cwd": "${pluginDir}",
        "initializationOptions": {
          "settings": {
            "java": {
              "configuration": {
                "updateBuildConfiguration": "automatic"
              }
            }
          }
        }
      }
    ]
  },
  "setup": {
    "downloads": [
      {
        "url": "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz",
        "extractTo": "./jdtls",
        "archive": "tar.gz"
      }
    ]
  }
}
