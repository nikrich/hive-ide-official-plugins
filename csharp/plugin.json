{
  "id": "hive-ide-official-plugins/csharp",
  "name": "C#",
  "version": "0.1.1",
  "description": "C# language support via OmniSharp-roslyn. Bundles the language server; requires the .NET 6+ runtime on PATH.",
  "publisher": "hive-ide-official-plugins",
  "engines": {
    "hive": ">=0.1.0 <1.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "csharp",
        "extensions": [
          ".cs",
          ".csx"
        ],
        "aliases": [
          "C#"
        ],
        "configuration": "./language-configuration.json",
        "grammar": "./grammar.json"
      }
    ],
    "languageServers": [
      {
        "language": "csharp",
        "command": "${pluginDir}/launch.sh",
        "args": [],
        "transport": "stdio"
      }
    ]
  },
