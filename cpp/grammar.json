{
  "defaultToken": "",
  "tokenPostfix": ".cpp",
  "keywords": [
    "alignas", "auto", "bool", "break", "case", "catch", "char", "class",
    "const", "constexpr", "continue", "decltype", "default", "delete", "do",
    "double", "else", "enum", "explicit", "export", "extern", "false",
    "float", "for", "friend", "goto", "if", "inline", "int", "long",
    "mutable", "namespace", "new", "noexcept", "nullptr", "operator",
    "private", "protected", "public", "register", "return", "short",
    "signed", "sizeof", "static", "struct", "switch", "template", "this",
    "throw", "true", "try", "typedef", "typename", "union", "unsigned",
    "using", "virtual", "void", "volatile", "while"
  ],
  "brackets": [
    { "open": "{", "close": "}", "token": "delimiter.curly" },
    { "open": "[", "close": "]", "token": "delimiter.square" },
    { "open": "(", "close": ")", "token": "delimiter.parenthesis" }
  ],
  "tokenizer": {
    "root": [
      ["^\\s*#\\s*include", { "token": "keyword.directive", "next": "@include" }],
      ["^\\s*#\\s*\\w+", "keyword.directive"],
      ["[a-zA-Z_]\\w*", {
        "cases": {
          "@keywords": "keyword",
          "@default": "identifier"
        }
      }],
      { "include": "@whitespace" },
      { "include": "@numbers" },
      { "include": "@strings" },
      ["::", "delimiter"],
      ["[{}()\\[\\]]", "@brackets"],
      ["[;,.]", "delimiter"],
      ["[=><!~?:&|+\\-*/^%]+", "operator"]
    ],
    "include": [
      ["<[^>]*>", { "token": "string", "next": "@pop" }],
      ["\"[^\"]*\"", { "token": "string", "next": "@pop" }],
      ["", { "token": "", "next": "@pop" }]
    ],
    "whitespace": [
      ["[ \\t\\r\\n]+", "white"],
      ["//.*$", "comment"],
      ["/\\*", { "token": "comment", "next": "@comment" }]
    ],
    "comment": [
      ["[^/*]+", "comment"],
      ["\\*/", { "token": "comment", "next": "@pop" }],
      ["[/*]", "comment"]
    ],
    "numbers": [
      ["0[xX][0-9a-fA-F']+[uUlL]*", "number.hex"],
      ["0[bB][01']+[uUlL]*", "number.binary"],
      ["\\d[\\d']*\\.\\d[\\d']*([eE][\\-+]?\\d+)?[fFlL]?", "number.float"],
      ["\\d[\\d']*([eE][\\-+]?\\d+)?[uUlLfF]*", "number"]
    ],
    "strings": [
      ["\"", { "token": "string.quote", "next": "@dqstring" }],
      ["'", { "token": "string.quote", "next": "@sqstring" }]
    ],
    "dqstring": [
      ["[^\\\\\"]+", "string"],
      ["\\\\.", "string.escape"],
      ["\"", { "token": "string.quote", "next": "@pop" }],
      ["$", "string", "@pop"]
    ],
    "sqstring": [
      ["[^\\\\']+", "string"],
      ["\\\\.", "string.escape"],
      ["'", { "token": "string.quote", "next": "@pop" }],
      ["$", "string", "@pop"]
    ]
  }
}
